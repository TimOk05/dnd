# D&D Copilot - Улучшенный .htaccess
# Оптимизация производительности и безопасности

# Включаем модуль перезаписи
RewriteEngine On

# Безопасность - скрываем информацию о сервере
ServerTokens Prod
ServerSignature Off

# Защита от просмотра директорий
Options -Indexes

# Защита от доступа к конфигурационным файлам
<FilesMatch "\.(env|config|ini|log|json|lock)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Защита от доступа к системным файлам
<FilesMatch "^(\.htaccess|\.htpasswd|\.git|\.svn|\.DS_Store|Thumbs\.db)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Защита от доступа к PHP файлам в определенных директориях
<FilesMatch "\.php$">
    <If "%{REQUEST_URI} =~ m#^/(config|services|cache|logs)/#">
        Order Allow,Deny
        Deny from all
    </If>
</FilesMatch>

# Gzip сжатие для ускорения загрузки
<IfModule mod_deflate.c>
    # Включаем сжатие для всех поддерживаемых типов
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml+rss
    
    # Убираем сжатие для браузеров с багами
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
    
    # Не сжимаем уже сжатые файлы
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|rar|zip|exe|flv|mov|wma|mp3|avi|swf|mp?g|mp4|webm|webp)$ no-gzip dont-vary
</IfModule>

# Кэширование браузера для статических файлов
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Изображения
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS и JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    
    # Шрифты
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    
    # HTML и данные
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType application/json "access plus 1 hour"
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType text/xml "access plus 1 hour"
    
    # По умолчанию
    ExpiresDefault "access plus 1 month"
</IfModule>

# Заголовки кэширования
<IfModule mod_headers.c>
    # Кэширование для статических файлов
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # Кэширование для HTML
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
    
    # Безопасность - заголовки
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    
    # Убираем заголовок X-Powered-By
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# Перенаправление на HTTPS (раскомментировать для продакшена)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Обработка ошибок
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# Защита от атак
# Блокировка подозрительных User-Agent
RewriteCond %{HTTP_USER_AGENT} ^$ [OR]
RewriteCond %{HTTP_USER_AGENT} ^(java|curl|wget) [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*(libwww-perl|curl|wget|python|nikto|scan) [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*(winhttp|HTTrack|clshttp|archiver|loader|email|harvest|extract|grab|miner) [NC]
RewriteRule .* - [F,L]

# Блокировка доступа к файлам с подозрительными расширениями
RewriteCond %{REQUEST_URI} \.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|old|orig|save|swo|sql|sqlite|sqlite3|db)$ [NC]
RewriteRule .* - [F,L]

# Защита от SQL Injection
RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC,OR]
RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2}) [OR]
RewriteCond %{QUERY_STRING} proc/self/environ [OR]
RewriteCond %{QUERY_STRING} mosConfig [OR]
RewriteCond %{QUERY_STRING} base64_(en|de)code[^(]*\([^)]*\) [OR]
RewriteCond %{QUERY_STRING} (<|%3C)([^s]*s)+cript.*(>|%3E) [NC,OR]
RewriteCond %{QUERY_STRING} (\<|%3C).*iframe.*(\>|%3E) [NC]
RewriteRule .* - [F,L]

# Ограничение размера загружаемых файлов
LimitRequestBody 10485760

# Ограничение времени выполнения скриптов
php_value max_execution_time 30
php_value max_input_time 60
php_value memory_limit 256M
php_value post_max_size 10M
php_value upload_max_filesize 10M

# Настройки сессий
php_value session.cookie_httponly 1
php_value session.cookie_secure 0
php_value session.cookie_samesite "Strict"
php_value session.gc_maxlifetime 28800
php_value session.cookie_lifetime 28800

# Отключение вывода ошибок в продакшене
php_flag display_errors off
php_flag log_errors on
php_value error_log logs/php_errors.log

# Установка временной зоны
php_value date.timezone "Europe/Moscow"

# Настройки безопасности PHP
php_flag allow_url_fopen off
php_flag allow_url_include off
php_flag expose_php off
php_flag register_globals off
php_flag magic_quotes_gpc off
php_flag session.use_only_cookies on
php_flag session.use_trans_sid off
